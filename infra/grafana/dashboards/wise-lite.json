{
  "uid": "wise-lite",
  "title": "wise-lite: money movement",
  "schemaVersion": 39,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "Transfer transitions / min",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (to) (rate(wiselite_transfers_transitions_total[1m]) * 60)",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 2,
      "title": "Outbox: unpublished events",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (application) (wiselite_outbox_unpublished)",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 3,
      "title": "Outbox: oldest unpublished (s)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (application) (wiselite_outbox_oldest_unpublished_age_seconds)",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 4,
      "title": "Payouts by status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (wiselite_payouts)",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 5,
      "title": "Oldest unresolved payout (s)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "wiselite_payouts_oldest_unresolved_age_seconds",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 6,
      "title": "Rail calls / s by outcome",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(wiselite_rails_calls_seconds_count[1m]))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 7,
      "title": "Rail call p99 latency (s)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(wiselite_rails_calls_seconds_bucket[5m])))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 8,
      "title": "Circuit breaker (0 closed, 1 open, 2 half-open)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "wiselite_rails_circuit_state",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 9,
      "title": "Webhooks by outcome / min",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(wiselite_rails_callbacks_total[1m]) * 60)",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 10,
      "title": "Reconciliation breaks (24h) by severity",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (severity) (increase(wiselite_recon_breaks_total[1d]))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 11,
      "title": "HTTP 5xx rate by service",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application) (rate(http_server_requests_seconds_count{status=~\"5..\"}[1m]))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 12,
      "title": "HTTP p99 latency by service (s)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, application) (rate(http_server_requests_seconds_bucket[5m])))",
          "legendFormat": "__auto"
        }
      ]
    }
  ]
}